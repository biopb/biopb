# Scenario: Bio-Formats / ZVI support, end-to-end
# Verifies that opting into Bio-Formats during install pulls the
# bioio-bioformats + scyjava + cjdk stack, that cjdk auto-fetches a JDK
# on first use (NO system Java is installed here, on purpose -- that is the whole
# point), and that a ZVI file can actually be read.
#
# Manual flow:
#   1. BIOPB_INSTALL_BIOFORMATS=1 bash /install.sh   # opt into Bio-Formats
#   2. /verify_bioformats.sh   # checks adapter, jar, JVM auto-fetch, ZVI read
#
# A ZVI sample is optional: mount one with
#   BIOPB_TEST_DATA=/path/with/file.zvi ./run.sh bioformats
# or bake one in at build time with --build-arg ZVI_SAMPLE_URL=...
# Without a sample the adapter/jar/JVM checks still run; only the read is skipped.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl git ca-certificates bash \
    && rm -rf /var/lib/apt/lists/*

# Data dir + config so `biopb server start` would discover a ZVI under /data.
RUN mkdir -p /data \
    && mkdir -p /root/.config/biopb && printf '%s\n' \
    '[server]' \
    'host = "127.0.0.1"' \
    'port = 8815' \
    '' \
    '[cache]' \
    'backend = "file"' \
    '' \
    '[[sources]]' \
    'url = "/data"' \
    'monitor = true' \
    > /root/.config/biopb/biopb.toml

# Optional: bake a ZVI sample into the image. Non-fatal if unset/unreachable
# (offline builds, moved URL) -- mounting via BIOPB_TEST_DATA is preferred.
ARG ZVI_SAMPLE_URL=""
RUN if [ -n "$ZVI_SAMPLE_URL" ]; then \
        curl -fsSL "$ZVI_SAMPLE_URL" -o /data/sample.zvi \
        || echo "WARN: could not fetch ZVI sample from $ZVI_SAMPLE_URL"; \
    fi

# Verification script for the installed Bio-Formats extra.
# Kept as a real file rather than a Dockerfile heredoc: heredoc support lives in
# the frontend, and the version BuildKit picks varies by daemon -- the CI runner's
# parsed the body as instructions ("unknown instruction: [server]").
COPY test/verify_bioformats.sh /verify_bioformats.sh
RUN chmod +x /verify_bioformats.sh

# The build context is install/ (run.sh passes $SCRIPT_DIR/..), so this path is
# relative to THAT, not to this file. `../install.sh` only ever worked on the
# legacy builder, which silently clamped it back into the context; BuildKit --
# the default everywhere now, including CI -- rejects it outright.
COPY install.sh /install.sh

CMD ["/bin/bash"]
